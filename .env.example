# Paste one or more Gemini API keys here, comma-separated (keys are tried in order with failover).
# Get free keys at https://aistudio.google.com
GEMINI_API_KEYS=your_key_1,your_key_2

# Gemma 4 models served through the Gemini API. The defaults work; change only if you must.
GEMMA_MODEL=gemma-4-31b-it
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it

# Optional. The app works fine with no Supabase (it falls back to data/forms.json
# and skips usage logging). To enable it, create a project at supabase.com, run
# supabase/schema.sql in the SQL editor, and paste the project URL + service role key here.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
