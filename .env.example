# Paste one or more Gemini API keys here, comma-separated (keys are tried in order with failover).
# Get free keys at https://aistudio.google.com
GEMINI_API_KEYS=your_key_1,your_key_2

# Gemma 4 models served through the Gemini API. The defaults work; change only if you must.
GEMMA_MODEL=gemma-4-31b-it
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it

# --- Accounts, sessions and the encrypted vault ---------------------------------
# Secret used to sign sessions and derive per-user encryption keys.
# Leave empty for a local dev key file (data/.secret.key); SET A LONG RANDOM VALUE IN PRODUCTION.
APP_SECRET_KEY=

# Session lifetime in days (default 7).
ACCESS_TOKEN_DAYS=7

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0

# Comma-separated emails that get admin rights (knowledge-base maintenance).
ADMIN_EMAILS=

# How long stored scans live before auto-deletion, and the per-user cap.
SCAN_RETENTION_DAYS=30
MAX_SCANS_PER_USER=100

# Where the SQLite database lives (defaults to data/samajh.db).
# SAMAJH_DB_PATH=

# --- Optional Supabase (shared forms knowledge base) -----------------------------
# The app works fine with no Supabase (it falls back to data/forms.json
# and skips usage logging). To enable it, create a project at supabase.com, run
# supabase/schema.sql in the SQL editor, and paste the project URL + service role key here.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
